{
  "hosting": {
    "site": "fx-domain",
    "public": "dist/firebase",
    "ignore": ["**/.*", "**/node_modules/**"],
    "redirects": [
      {"source": "/apps", "destination": "/", "type": 301},
      {"source": "/apps/", "destination": "/", "type": 301},
      {"source": "/apps/index.html", "destination": "/", "type": 301}
    ],
    "headers": [
      {"source": "**", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/data/**", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
    ]
  }
}
